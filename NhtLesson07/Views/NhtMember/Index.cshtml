@model IEnumerable<NhtLesson07.Models.NhtMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NhtUsername)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NhtPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NhtEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NhtPhone)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.NhtUsername)
            </td>
            <td>
                @Html.DisplayFor(model => item.NhtPassword)
            </td>
            <td>
                @Html.DisplayFor(model => item.NhtEmail)
            </td>
            <td>
                @Html.DisplayFor(model => item.NhtPhone)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
